{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrhino.ai/schema/model-package/v0",
  "title": "VRhino Runnable Model Package v0",
  "type": "object",
  "required": ["schema_version", "identity", "compatibility", "artifacts", "entrypoint", "defaults", "hardware", "source", "license"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {
      "type": "object",
      "required": ["namespace", "name", "version", "architecture", "publisher"],
      "properties": {
        "namespace": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "architecture": {"$ref": "#/$defs/identifier"},
        "publisher": {"type": "string", "minLength": 1}
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["runtime_contract", "vrm_schema"],
      "properties": {
        "runtime_contract": {"const": "cuda-v1"},
        "vrm_schema": {
          "type": "object",
          "required": ["format_major", "format_minor", "metadata_schema"],
          "properties": {
            "format_major": {"const": 0},
            "format_minor": {"const": 1},
            "metadata_schema": {"const": 1}
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {"enum": ["text_to_video", "lip_sync"]},
        "status": {"$ref": "#/$defs/identifier"},
        "workflow_identity": {"$ref": "#/$defs/identifier"},
        "workflow_artifact": {"$ref": "#/$defs/identifier"},
        "execution_artifact": {"$ref": "#/$defs/identifier"},
        "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "public_distribution": {"$ref": "#/$defs/identifier"},
        "input_schema": {"$ref": "#/$defs/productInputSchemaV1"},
        "frozen_profile": {"$ref": "#/$defs/productFrozenProfileV1"}
      },
      "oneOf": [
        {
          "required": ["family", "status", "workflow_identity", "workflow_artifact", "execution_artifact", "required_inputs", "public_distribution"],
          "not": {"anyOf": [{"required": ["input_schema"]}, {"required": ["frozen_profile"]}]}
        },
        {
          "required": ["family", "status", "public_distribution", "input_schema", "frozen_profile"],
          "not": {"required": ["required_inputs"]},
          "allOf": [
            {
              "if": {"properties": {"family": {"const": "lip_sync"}}},
              "then": {"required": ["workflow_identity", "workflow_artifact", "execution_artifact"]}
            }
          ]
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "path", "size", "sha256", "required"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "role": {"$ref": "#/$defs/identifier"},
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required": {"type": "boolean"}
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["components", "default_preset"],
      "anyOf": [{"required": ["runtime_artifact"]}, {"required": ["workflow_artifact"]}],
      "properties": {
        "runtime_artifact": {"$ref": "#/$defs/identifier"},
        "workflow_artifact": {"$ref": "#/$defs/identifier"},
        "default_preset": {"$ref": "#/$defs/identifier"},
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "artifacts"],
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "role": {"$ref": "#/$defs/identifier"},
              "kind": {"$ref": "#/$defs/identifier"},
              "artifacts": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["default_preset", "presets"],
      "properties": {
        "default_preset": {"$ref": "#/$defs/identifier"},
        "presets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["profile_artifact"],
            "properties": {"profile_artifact": {"$ref": "#/$defs/identifier"}, "inputs": {"type": "object"}}
          }
        }
      }
    },
    "hardware": {"type": "object", "required": ["presets"], "properties": {"presets": {"type": "object"}}},
    "source": {
      "type": "object",
      "required": ["repository", "revision", "converter_version"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "converter_version": {"type": "string", "minLength": 1}
      }
    },
    "license": {
      "type": "object",
      "required": ["identifier", "artifact", "upstream_notice"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/identifier"},
        "upstream_notice": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "uint64Bound": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
      ]
    },
    "rational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "textValidation": {"type": "object", "additionalProperties": false, "properties": {"min_length": {"type": "integer", "minimum": 0}}},
    "integerValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"minimum": {"$ref": "#/$defs/uint64Bound"}, "maximum": {"$ref": "#/$defs/uint64Bound"}}
    },
    "videoValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"regular_file": {"const": true}, "decodable": {"const": true}, "fps": {"$ref": "#/$defs/rational"}}
    },
    "audioValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"regular_file": {"const": true}, "decodable": {"const": true}, "minimum_duration_ms": {"type": "integer", "minimum": 1}}
    },
    "outputValidation": {"type": "object", "additionalProperties": false, "properties": {"parent_creatable_and_writable": {"const": true}}},
    "textDeclaration": {
      "type": "object", "required": ["name", "type", "required"], "additionalProperties": false,
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "text"}, "required": {"type": "boolean"}, "default": {"type": "string", "minLength": 1}, "validation": {"$ref": "#/$defs/textValidation"}},
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"not": {"required": ["default"]}}}]
    },
    "integerDeclaration": {
      "type": "object", "required": ["name", "type", "required"], "additionalProperties": false,
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "integer"}, "required": {"type": "boolean"}, "default": {"$ref": "#/$defs/uint64Bound"}, "validation": {"$ref": "#/$defs/integerValidation"}},
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"not": {"required": ["default"]}}}]
    },
    "videoDeclaration": {
      "type": "object", "required": ["name", "type", "required"], "additionalProperties": false,
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "media.video"}, "required": {"type": "boolean"}, "default": {"type": "string", "minLength": 1}, "validation": {"$ref": "#/$defs/videoValidation"}},
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"not": {"required": ["default"]}}}]
    },
    "audioDeclaration": {
      "type": "object", "required": ["name", "type", "required"], "additionalProperties": false,
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "media.audio"}, "required": {"type": "boolean"}, "default": {"type": "string", "minLength": 1}, "validation": {"$ref": "#/$defs/audioValidation"}},
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"not": {"required": ["default"]}}}]
    },
    "mp4Declaration": {
      "type": "object", "required": ["name", "type", "required"], "additionalProperties": false,
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "media.mp4"}, "required": {"type": "boolean"}, "default": {"type": "string", "minLength": 1}, "validation": {"$ref": "#/$defs/outputValidation"}},
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"not": {"required": ["default"]}}}]
    },
    "productInputSchemaV1": {
      "type": "object",
      "required": ["schema", "inputs", "parameters", "outputs"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "vrhino.product.input-schema.v1"},
        "inputs": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/textDeclaration"}, {"$ref": "#/$defs/videoDeclaration"}, {"$ref": "#/$defs/audioDeclaration"}]}},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/integerDeclaration"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/mp4Declaration"}}
      }
    },
    "productFrozenProfileV1": {
      "type": "object",
      "required": ["output"],
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "object", "required": ["fps", "duration", "audio"], "additionalProperties": false,
          "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "frames": {"type": "integer", "minimum": 1}, "fps": {"$ref": "#/$defs/rational"}, "duration": {"enum": ["fixed", "audio_derived"]}, "audio": {"enum": ["none", "driving_audio"]}}
        },
        "sampling": {
          "type": "object", "additionalProperties": false,
          "properties": {"method": {"type": "string", "minLength": 1}, "prediction": {"type": "string", "minLength": 1}, "steps": {"type": "integer", "minimum": 1}, "guidance_scale": {"type": "number", "minimum": 0}, "eta": {"type": "number", "minimum": 0}}
        },
        "temporal": {"type": "object", "required": ["chunk_frames"], "additionalProperties": false, "properties": {"chunk_frames": {"type": "integer", "minimum": 1}}}
      }
    }
  }
}
